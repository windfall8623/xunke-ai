# Run python deploy/init_env.py once to create deploy/.env with five independent secrets.
# Edit an existing deploy/.env in place; never replace its database/session secrets.
# Keep deploy/.env private; never put model or database keys into VITE_* variables.
# Compose uses --env-file deploy/.env, not backend/.env. See README.md.
MYSQL_DATABASE=zhixue_ai
MYSQL_USER=zhixue
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
EVAL_WORKER_TOKEN=
WEB_ORIGINS=["https://learn.example.com"]
IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443

# 邮箱验证码注册：需配置 SMTP；关闭只禁用新注册，旧账号仍可登录。
# QQ: smtp.qq.com:465；163: smtp.163.com:465。先在邮箱设置中开启 SMTP。
# SMTP_PASSWORD 填客户端授权码，不是邮箱登录密码；禁止提交真实值。
EMAIL_REGISTRATION_ENABLED=true
# init_env.py 自动生成；已有环境请添加独立随机值（至少 32 字符）。
EMAIL_CODE_SECRET=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=循课
SMTP_TIMEOUT_SECONDS=10
# 6 位验证码固定 10 分钟有效；5 次输错锁定本轮，重发不重置次数。
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_SEND_MAX_PER_EMAIL_PER_DAY=5
EMAIL_SEND_MAX_PER_IP_PER_HOUR=10
# 日期按 UTC 计；发送失败/超时也计入额度，达到上限返回 429 并记安全告警。
EMAIL_SEND_DAILY_LIMIT=100

# Enable new practice and short-answer model grading explicitly.
# Without an approved profile, model grades remain provisional.
PRACTICE_ENABLED=true
# 课程生成：每次先纲要、后单课，复用现有 LLM 配置。
COURSE_ENABLED=true
# 轻量体验诊断：只记录白名单事件与耗时，30 天保留；关闭不影响学习。
EXPERIENCE_EVENTS_ENABLED=true
# 私有正文流预览；既有 /events 仍只推送阶段。关闭时完整结果照常返回。
CONTENT_EVENTS_ENABLED=false
# 标准教学：LangGraph Planner / Teacher / Reviewer；旧请求默认 fast。
ENABLE_COURSE_TEACHING_AGENTS=false
# Reviewer 单次默认 60 秒，可配置 1–120 秒；受任务剩余时间与发布预留共同限制。
COURSE_TEACHING_REVIEW_TIMEOUT_SECONDS=60
COURSE_TEACHING_REPAIR_TIMEOUT_SECONDS=90
COURSE_TEACHING_PUBLICATION_RESERVE_SECONDS=5
COURSE_PROVIDER_TIMEOUT_SECONDS=120
COURSE_JOB_DEADLINE_SECONDS=300
PRACTICE_SHORT_ANSWER_ENABLED=true
PRACTICE_GRADING_OUTPUT_TOKENS=2048
PRACTICE_GRADING_CONTEXT_WINDOW=32768
PRACTICE_GRADING_PROFILE_PATH=
PRACTICE_GRADING_PROFILE_HASH=

# Select exactly one provider: anthropic / deepseek / openai_compatible.
# This new-environment example uses native Claude. Older deployments without
# LLM_PROVIDER retain DeepSeek. Only the selected provider's settings are read.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set these only when selecting deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAI-compatible gateways require all three explicit values, with no fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Slow chat models need time for ranking, answering, and semantic validation.
# SDK timeout bounds each call; the job deadline bounds the complete pipeline.
PROVIDER_TIMEOUT_SECONDS=240
JOB_DEADLINE_SECONDS=600
# Missing keys are reported explicitly; the guest experience remains local.
# Document RAG needs an independent embedding service even when Claude is selected.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_BASE_URL=
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Start with the dense baseline; decide enhancements using fixed-data comparison.
RAG_PIPELINE_ID=dense-v1
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_MODEL_REVISION=
RERANKER_LICENSE=
# Chat ranking reuses LLM_PROVIDER; enable with hybrid-llm-rerank-v1.
RERANKER_LLM_MAX_INPUT_TOKENS=12000
RERANKER_LLM_MAX_OUTPUT_TOKENS=512
# LLM ranking allows up to 180s, capped by PROVIDER_TIMEOUT_SECONDS and job time.
RERANKER_LLM_TIMEOUT_SECONDS=90
PRICING_VERSION=unconfigured
# PRICING_USD_TO_CNY=7
# Add these only after verifying the selected provider's prices, in CNY.
# Update prices/version when switching models; record any conversion from USD.
# Omitting means unknown; do not use empty strings or zero for unknown prices.
# LLM_INPUT_CNY_PER_MILLION=
# LLM_OUTPUT_CNY_PER_MILLION=
# LLM_CACHE_READ_CNY_PER_MILLION=
# LLM_CACHE_WRITE_CNY_PER_MILLION=
# EMBEDDING_CNY_PER_MILLION=
# RERANK_CALL_CNY=
# SEARCH_CALL_CNY=
# IMAGE_CALL_CNY=
PRODUCTION_DAILY_COST_CNY=100
GLOBAL_DAILY_COST_CNY=1000
EVAL_INGEST_DAILY_COST_CNY=20
EVAL_DAILY_COST_CNY=200

# Optional, SHA-256 verified original source snapshot for evaluation-only B0.
# The container path must point into app_data, e.g. /app/data/baselines/7302ad2.tar.gz.
LEGACY_SOURCE_ARCHIVE=
LEGACY_SOURCE_ARCHIVE_SHA256=
LEGACY_SOURCE_COMMIT=7302ad2
LEGACY_LINK_ENABLED=false
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# Continuous scorer control failure exits nonzero so Docker can rejoin API networking.
# Range: 1–3600 seconds. Successful polling resets the window.
EVAL_CONTROL_OUTAGE_SECONDS=60

# Only used with compose.judge.yaml and explicit per-run judge configuration.
# The judge independently supports Anthropic and OpenAI-compatible endpoints.
# Explicitly set the judge JSON and key; it does not inherit LLM_PROVIDER.
EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_CONFIG_FILE=/absolute/path/to/reviewed-judge-config.json

# 可选 Redis：共享短窗限流与任务事件通知（配合 deploy/compose.redis.yaml 覆盖文件）。
# 短窗门槛是 SQL 硬限制之前的新增突发拦截；关闭或故障时原 SQL 限流/轮询路径继续工作。
# REDIS_PASSWORD 必须是独立随机值（至少 32 字符），不与 JWT_SECRET/EMAIL_CODE_SECRET 复用；
# 新环境由 init_env.py 生成，已有 deploy/.env 请定向补充该字段。
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=xunke:production:v1
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_OPERATION_TIMEOUT_MS=200
REDIS_MAX_CONNECTIONS=16

# 共享突发短窗：只统计进入后续 SQL 检查的请求；SQL 硬限制（20 次/15 分钟等）始终执行。
REDIS_RATE_LIMIT_ENABLED=false
AUTH_BURST_WINDOW_SECONDS=60
AUTH_BURST_MAX_PER_IP=20
AUTH_BURST_MAX_PER_ACCOUNT=10
EMAIL_BURST_WINDOW_SECONDS=60
EMAIL_BURST_MAX_PER_IP=10
EMAIL_BURST_MAX_PER_ACCOUNT=3

# 任务阶段 SSE（配合 REDIS_ENABLED）：
# TASK_EVENTS_ENABLED 开启 /api/v1/qa|courses/tasks/{id}/events；事件保留期与补读周期见下。
TASK_EVENTS_ENABLED=false
TASK_EVENT_RETENTION_HOURS=24
TASK_EVENT_SYNC_SECONDS=15
TASK_EVENT_MAX_CONNECTION_SECONDS=900

# 可选 Qdrant（配合 compose.qdrant.yaml）。已有数据必须先迁移，不直接改开关。
# 基础 compose 不使用这些设置，仍保持 Chroma 单 owner。
VECTOR_BACKEND=qdrant
VECTOR_TARGET_REVISION=qdrant-v1
VECTOR_PROJECTION_REGISTRY_REQUIRED=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=xunke_dense
QDRANT_API_KEY=
QDRANT_READ_ONLY_API_KEY=
QDRANT_GENERATION_WORKERS=2
QDRANT_SEARCH_TIMEOUT_SECONDS=5
QDRANT_WRITE_TIMEOUT_SECONDS=30
QDRANT_RPC_CONCURRENCY=4
QDRANT_BATCH_SIZE=128
QDRANT_MAX_REQUEST_BYTES=2097152
QDRANT_VECTOR_ON_DISK=true
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_HNSW_EF_SEARCH=64

# 查询向量缓存（配合 compose.cache.yaml）；未指定可信模型revision时自动绕过。
# 不把可变模型别名当作冻结版本；评测和文档入库始终不读取查询缓存。
QUERY_EMBEDDING_CACHE_ENABLED=false
QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL_REVISION=
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_PASSWORD=
REDIS_CACHE_TLS=false
