# Run python deploy/init_env.py once to create deploy/.env with four independent secrets.
# Edit an existing deploy/.env in place; never replace its database/session secrets.
# Keep deploy/.env private; never put model or database keys into VITE_* variables.
# Compose uses --env-file deploy/.env, not backend/.env. See docs/llm-configuration.md.
MYSQL_DATABASE=zhixue_ai
MYSQL_USER=zhixue
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
EVAL_WORKER_TOKEN=
WEB_ORIGINS=["https://learn.example.com"]
IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443

# Enable new practice and short-answer model grading explicitly.
# Without an approved profile, model grades remain provisional.
PRACTICE_ENABLED=true
PRACTICE_SHORT_ANSWER_ENABLED=true
PRACTICE_GRADING_OUTPUT_TOKENS=2048
PRACTICE_GRADING_CONTEXT_WINDOW=32768
PRACTICE_GRADING_PROFILE_PATH=
PRACTICE_GRADING_PROFILE_HASH=

# Select exactly one provider: anthropic / deepseek / openai_compatible.
# This new-environment example uses native Claude. Older deployments without
# LLM_PROVIDER retain DeepSeek. Only the selected provider's settings are read.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set these only when selecting deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAI-compatible gateways require all three explicit values, with no fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Slow chat models need time for ranking, answering, and semantic validation.
# SDK timeout bounds each call; the job deadline bounds the complete pipeline.
PROVIDER_TIMEOUT_SECONDS=240
JOB_DEADLINE_SECONDS=600
# Missing keys are reported explicitly; the guest experience remains local.
# Document RAG needs an independent embedding service even when Claude is selected.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_BASE_URL=
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Start with the dense baseline; decide enhancements using fixed-data comparison.
RAG_PIPELINE_ID=dense-v1
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_MODEL_REVISION=
RERANKER_LICENSE=
# Chat ranking reuses LLM_PROVIDER; enable with hybrid-llm-rerank-v1.
RERANKER_LLM_MAX_INPUT_TOKENS=12000
RERANKER_LLM_MAX_OUTPUT_TOKENS=512
# LLM ranking allows up to 180s, capped by PROVIDER_TIMEOUT_SECONDS and job time.
RERANKER_LLM_TIMEOUT_SECONDS=90
PRICING_VERSION=unconfigured
# PRICING_USD_TO_CNY=7
# Add these only after verifying the selected provider's prices, in CNY.
# Update prices/version when switching models; record any conversion from USD.
# Omitting means unknown; do not use empty strings or zero for unknown prices.
# LLM_INPUT_CNY_PER_MILLION=
# LLM_OUTPUT_CNY_PER_MILLION=
# LLM_CACHE_READ_CNY_PER_MILLION=
# LLM_CACHE_WRITE_CNY_PER_MILLION=
# EMBEDDING_CNY_PER_MILLION=
# RERANK_CALL_CNY=
# SEARCH_CALL_CNY=
# IMAGE_CALL_CNY=
PRODUCTION_DAILY_COST_CNY=100
GLOBAL_DAILY_COST_CNY=1000
EVAL_INGEST_DAILY_COST_CNY=20
EVAL_DAILY_COST_CNY=200

# Optional, SHA-256 verified original source snapshot for evaluation-only B0.
# The container path must point into app_data, e.g. /app/data/baselines/7302ad2.tar.gz.
LEGACY_SOURCE_ARCHIVE=
LEGACY_SOURCE_ARCHIVE_SHA256=
LEGACY_SOURCE_COMMIT=7302ad2
LEGACY_LINK_ENABLED=false
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# Continuous scorer control failure exits nonzero so Docker can rejoin API networking.
# Range: 1–3600 seconds. Successful polling resets the window.
EVAL_CONTROL_OUTAGE_SECONDS=60

# Only used with compose.judge.yaml and explicit per-run judge configuration.
# The judge independently supports Anthropic and OpenAI-compatible endpoints.
# Explicitly set the judge JSON and key; it does not inherit LLM_PROVIDER.
EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_CONFIG_FILE=/absolute/path/to/reviewed-judge-config.json
