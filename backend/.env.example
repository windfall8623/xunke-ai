# 网页后端开发环境；从 backend/ 启动时读取同目录 .env。
# 复制后填写本地连接信息。所有密钥/密码留空，不要提交真实值。
# Compose 使用 deploy/env.example 与 deploy/init_env.py，不读取本文件。

# 服务、会话与身份
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO
DATA_DIR=./data
WEB_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:18080","http://127.0.0.1:18080"]
COOKIE_SECURE=false
SESSION_DAYS=7
AUTH_RATE_LIMIT=20
# JWT_SECRET 与 EVAL_WORKER_TOKEN 分别填写独立随机值（至少 32 字符）。
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200
EVAL_WORKER_TOKEN=
LEGACY_LINK_ENABLED=false

# QQ/163 邮箱 SMTP 验证码注册；缺少凭据时新注册关闭，已有登录不受影响。
EMAIL_REGISTRATION_ENABLED=true
# 独立随机值至少 32 字符，不与 JWT_SECRET 或 SMTP 授权码复用。
EMAIL_CODE_SECRET=
SMTP_HOST=smtp.qq.com
# 163 使用 smtp.163.com；默认 SSL 465，可显式使用 starttls 与对应端口。
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
# 填 SMTP 客户端授权码，不是邮箱登录密码。
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=循课
SMTP_TIMEOUT_SECONDS=10
EMAIL_SEND_COOLDOWN_SECONDS=60
EMAIL_SEND_MAX_PER_EMAIL_PER_DAY=5
EMAIL_SEND_MAX_PER_IP_PER_HOUR=10
EMAIL_SEND_DAILY_LIMIT=100

PRACTICE_ENABLED=true
# 课程与单课按需生成，复用下方 LLM；资料课程同时使用 Embedding / RAG。
COURSE_ENABLED=true
COURSE_PROVIDER_TIMEOUT_SECONDS=120
COURSE_JOB_DEADLINE_SECONDS=300
PRACTICE_SHORT_ANSWER_ENABLED=true
PRACTICE_GRADING_OUTPUT_TOKENS=2048
PRACTICE_GRADING_CONTEXT_WINDOW=32768
# 正式校准批准缺失时保持空值；开启模型评分不等于自动确认。
PRACTICE_GRADING_PROFILE_PATH=
PRACTICE_GRADING_PROFILE_HASH=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 生产必须 APP_ENV=production、COOKIE_SECURE=true、HTTPS WEB_ORIGINS，
# 配置独立随机凭据，且 MYSQL_AUTO_INIT=false；迁移单独执行。

# MySQL；本地开发使用独立数据库，避免误连已有用户数据。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zhixue_ai
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=false

# 持久任务与有界调用
QUIZ_MIN_QUESTIONS=3
QUIZ_MAX_QUESTIONS=10
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=2
JOB_DEADLINE_SECONDS=600
JOB_QUEUE_TTL_SECONDS=900
# 每次模型请求的时限；整条任务时限还需容纳重排、生成、核验和追问改写。
PROVIDER_TIMEOUT_SECONDS=240
USER_DAILY_LLM_CALLS=200
GLOBAL_DAILY_LLM_CALLS=2000
EVAL_DAILY_LLM_CALLS=2000

# 生成、语义检查与报告；按 LLM_PROVIDER 只读取对应的一组配置。
# 新环境示例选用原生 Claude；旧部署省略 LLM_PROVIDER 时仍使用 DeepSeek。
# 三选一：anthropic / deepseek / openai_compatible。无跨供应商密钥回退。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# 选择 deepseek 时填写以下配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 选择 openai_compatible 时必须显式填写全部三项；用于兼容接口网关。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 原生 Claude 使用 Anthropic Messages 接口，不使用 OpenAI 兼容网关配置。
# 模型可自定义；输出上限固定为 4096 token，SDK 重试关闭。
# 配置位置、服务依赖和切换步骤见 ../docs/llm-configuration.md。

# RAG 的独立 Embedding；Claude 不替代此服务，变更模型或维度需要构建新索引。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10

# 明确配置的生产检索方案；候选列表和比较方法见运行手册。
RAG_PIPELINE_ID=dense-v1
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_MODEL_REVISION=
RERANKER_LICENSE=
# Chat ranking reuses the selected LLM provider/model/key; choose
# RAG_PIPELINE_ID=hybrid-llm-rerank-v1. Do not put Claude in RERANKER_MODEL.
RERANKER_LLM_MAX_INPUT_TOKENS=12000
RERANKER_LLM_MAX_OUTPUT_TOKENS=512
# LLM 重排最多可设 180 秒，实际仍受单次请求和任务剩余时间约束。
RERANKER_LLM_TIMEOUT_SECONDS=90

# 联网还要求用户请求显式授权；不会自动发送私有原文。
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# 可选配图；专用 API Key 留空时回退使用 DASHSCOPE_API_KEY。
# DASHSCOPE_IMAGE_BASE_URL 留空时从 DASHSCOPE_BASE_URL 派生原生 /api/v1 地址。
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5

# 价格必须由所选供应商价格表确认；切换模型时同步更新价格与版本。
# 单位为人民币；美元报价需按记录的汇率折算。未知时保持注释，不使用空字符串或零替代。
PRICING_VERSION=unconfigured
# PRICING_USD_TO_CNY=7
# LLM_INPUT_CNY_PER_MILLION=
# LLM_OUTPUT_CNY_PER_MILLION=
# LLM_CACHE_READ_CNY_PER_MILLION=
# LLM_CACHE_WRITE_CNY_PER_MILLION=
# EMBEDDING_CNY_PER_MILLION=
# RERANK_CALL_CNY=
# SEARCH_CALL_CNY=
# IMAGE_CALL_CNY=
PRODUCTION_DAILY_COST_CNY=100
GLOBAL_DAILY_COST_CNY=1000
EVAL_INGEST_DAILY_COST_CNY=20
EVAL_DAILY_COST_CNY=200

# API 只读取不含密钥的固定 Judge 配置，支持独立 Anthropic / OpenAI-compatible 接口。
# 不随 LLM_PROVIDER 自动切换；可显式配置为相同 Claude 模型，凭据仅注入独立 scorer。
# 使用 evaluation/README.md 的 EVAL_JUDGE_API_KEY 与 --allow-external-judge。
EVAL_JUDGE_CONFIG_PATH=
DEBUG_RETENTION_DAYS=30
EVAL_RETENTION_DAYS=90

# 仅供评测 B0 的原始源码快照；缺少有效 SHA-256 时不提供 B0 方案。
LEGACY_SOURCE_ARCHIVE=
LEGACY_SOURCE_ARCHIVE_SHA256=
LEGACY_SOURCE_COMMIT=7302ad2

# 以下为旧知识库/图片兼容服务配置。网页 owner 的持久目录由 DATA_DIR 管理，
# 新版分块/检索参数使用固定 index profile / pipeline 配置。
CHROMA_PERSIST_DIR=./data/chroma
KB_UPLOAD_DIR=./data/uploads
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=
