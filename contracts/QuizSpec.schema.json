{
  "$defs": {
    "QuizCourseCriterion": {
      "additionalProperties": false,
      "description": "Server-selected local goal references; not authorization identities.",
      "properties": {
        "course_criterion_ref": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$",
          "title": "Course Criterion Ref",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "recognition",
            "recall",
            "application",
            "explanation",
            "creation"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "expectation": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Expectation",
          "type": "string"
        }
      },
      "required": [
        "course_criterion_ref",
        "description",
        "evidence_type",
        "expectation"
      ],
      "title": "QuizCourseCriterion",
      "type": "object"
    },
    "RequestedDocument": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "section_catalog_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Catalog Revision"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        }
      },
      "required": [
        "doc_id"
      ],
      "title": "RequestedDocument",
      "type": "object"
    },
    "RequestedScope": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/RequestedDocument"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        },
        "type": {
          "const": "selected_documents",
          "default": "selected_documents",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "documents"
      ],
      "title": "RequestedScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "course_criteria": {
      "items": {
        "$ref": "#/$defs/QuizCourseCriterion"
      },
      "maxItems": 10,
      "title": "Course Criteria",
      "type": "array"
    },
    "difficulty": {
      "default": "mixed",
      "enum": [
        "easy",
        "medium",
        "hard",
        "mixed"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "objective_titles": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Objective Titles",
      "type": "array"
    },
    "question_count": {
      "default": 5,
      "maximum": 10,
      "minimum": 3,
      "title": "Question Count",
      "type": "integer"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestedScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_policy": {
      "default": "topic",
      "enum": [
        "topic",
        "strict_docs",
        "doc_plus_web"
      ],
      "title": "Source Policy",
      "type": "string"
    },
    "user_input": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "User Input",
      "type": "string"
    }
  },
  "required": [
    "user_input"
  ],
  "title": "QuizSpec",
  "type": "object"
}
