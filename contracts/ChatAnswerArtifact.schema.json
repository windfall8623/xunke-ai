{
  "$defs": {
    "AnswerBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Citation Refs",
          "type": "array"
        },
        "kind": {
          "default": "fact",
          "enum": [
            "fact",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "text"
      ],
      "title": "AnswerBlock",
      "type": "object"
    },
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "chunk_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "index_build_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Build Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/DocumentLocator"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "retrieval_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Retrieval Scores",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_type": {
          "const": "document",
          "default": "document",
          "title": "Source Type",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "owner_id",
        "namespace",
        "title",
        "excerpt",
        "text_hash",
        "doc_id",
        "document_version_id",
        "parse_artifact_id",
        "index_build_id",
        "attempt_id",
        "chunk_id",
        "locator"
      ],
      "title": "DocumentEvidence",
      "type": "object"
    },
    "DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "canonical_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Text Hash",
          "type": "string"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "normalizer_version": {
          "title": "Normalizer Version",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "table_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        }
      },
      "required": [
        "source_sha256",
        "parse_artifact_id",
        "canonical_text_hash",
        "parser_version",
        "normalizer_version",
        "block_id",
        "start_char",
        "end_char",
        "quote_hash"
      ],
      "title": "DocumentLocator",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_status": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "reported"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "embedding_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Calls",
          "type": "integer"
        },
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "fetch_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Fetch Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reranker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Reranker Calls",
          "type": "integer"
        },
        "search_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "stage_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Ms",
          "type": "object"
        },
        "token_count_method": {
          "default": "provider-reported-or-utf8-upper-bound-v1",
          "title": "Token Count Method",
          "type": "string"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_status": {
      "enum": [
        "answered",
        "partial",
        "needs_clarification",
        "insufficient_evidence",
        "conflicting_sources"
      ],
      "title": "Answer Status",
      "type": "string"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/AnswerBlock"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "case_type": {
      "const": "qa",
      "default": "qa",
      "title": "Case Type",
      "type": "string"
    },
    "effective_config": {
      "additionalProperties": true,
      "title": "Effective Config",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/DocumentEvidence"
      },
      "maxItems": 40,
      "title": "Evidence",
      "type": "array"
    },
    "model_fingerprint": {
      "default": "unconfigured",
      "title": "Model Fingerprint",
      "type": "string"
    },
    "pipeline_config_hash": {
      "title": "Pipeline Config Hash",
      "type": "string"
    },
    "prompt_version": {
      "default": "qa-v1",
      "title": "Prompt Version",
      "type": "string"
    },
    "retrieval_query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Retrieval Query",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_fingerprint": {
      "title": "Scope Fingerprint",
      "type": "string"
    },
    "trace": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Trace",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "answer_status",
    "blocks",
    "run_id",
    "retrieval_query",
    "scope_fingerprint",
    "pipeline_config_hash"
  ],
  "title": "ChatAnswerArtifact",
  "type": "object"
}
