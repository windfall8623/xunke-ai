{
  "$defs": {
    "JsonValue": {},
    "PracticeAssessmentView": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "attempt_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "confirmation": {
          "enum": [
            "confirmed",
            "provisional"
          ],
          "title": "Confirmation",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "criterion_results": {
          "items": {
            "$ref": "#/$defs/PracticeCriterionResultView"
          },
          "title": "Criterion Results",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "feedback": {
          "default": "",
          "maxLength": 12000,
          "title": "Feedback",
          "type": "string"
        },
        "independent_eligible": {
          "default": false,
          "title": "Independent Eligible",
          "type": "boolean"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "source": {
          "enum": [
            "deterministic",
            "model",
            "human"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "graded",
            "needs_review",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "supersedes_assessment_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Assessment Id"
        }
      },
      "required": [
        "assessment_id",
        "attempt_id",
        "revision",
        "status",
        "source",
        "confirmation"
      ],
      "title": "PracticeAssessmentView",
      "type": "object"
    },
    "PracticeCriterionResultView": {
      "additionalProperties": false,
      "properties": {
        "answer_quotes": {
          "items": {
            "type": "string"
          },
          "title": "Answer Quotes",
          "type": "array"
        },
        "credit": {
          "enum": [
            "full",
            "half",
            "none",
            "uncertain"
          ],
          "title": "Credit",
          "type": "string"
        },
        "criterion_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "maxLength": 4000,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "credit"
      ],
      "title": "PracticeCriterionResultView",
      "type": "object"
    },
    "PublicClozeQuestion": {
      "additionalProperties": false,
      "properties": {
        "blank_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Blank Ids",
          "type": "array"
        },
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Citation Refs",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "question_version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Version",
          "type": "string"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "type": {
          "const": "cloze",
          "default": "cloze",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question_version",
        "stem",
        "difficulty",
        "concept_ids",
        "citation_refs",
        "blank_ids"
      ],
      "title": "PublicClozeQuestion",
      "type": "object"
    },
    "PublicNumericQuestion": {
      "additionalProperties": false,
      "properties": {
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Citation Refs",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "question_version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Version",
          "type": "string"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "type": {
          "const": "numeric",
          "default": "numeric",
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question_version",
        "stem",
        "difficulty",
        "concept_ids",
        "citation_refs",
        "unit"
      ],
      "title": "PublicNumericQuestion",
      "type": "object"
    },
    "PublicShortAnswerQuestion": {
      "additionalProperties": false,
      "properties": {
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Citation Refs",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
