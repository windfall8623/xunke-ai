        "projection_status": {
          "enum": [
            "not_ready",
            "pending",
            "pending_assessments",
            "current",
            "failed"
          ],
          "title": "Projection Status",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionView"
            },
            {
              "discriminator": {
                "mapping": {
                  "cloze": "#/$defs/PublicClozeQuestion",
                  "numeric": "#/$defs/PublicNumericQuestion",
                  "short_answer": "#/$defs/PublicShortAnswerQuestion"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PublicClozeQuestion"
                },
                {
                  "$ref": "#/$defs/PublicNumericQuestion"
                },
                {
                  "$ref": "#/$defs/PublicShortAnswerQuestion"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Question"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question_type": {
          "enum": [
            "single",
            "multiple",
            "judge",
            "cloze",
            "numeric",
            "short_answer"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "question_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question Version"
        },
        "result_status": {
          "enum": [
            "wrong",
            "partial"
          ],
          "title": "Result Status",
          "type": "string"
        },
        "scope_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Revision"
        },
        "source_status": {
          "enum": [
            "active",
            "revoked"
          ],
          "title": "Source Status",
          "type": "string"
        },
        "space_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Space Id"
        }
      },
      "required": [
        "item_id",
        "attempt_id",
        "origin_kind",
        "origin_id",
        "question_id",
        "question_version",
        "question_type",
        "space_id",
        "scope_revision",
        "occurred_at",
        "help_usage",
        "association_status",
        "concepts",
        "question",
        "correct_answers",
        "current_assessment",
        "result_status",
        "projection_status",
        "next_reviews",
        "source_status"
