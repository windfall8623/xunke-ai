    "QuestionOption": {
      "properties": {
        "key": {
          "description": "选项标识，如 A、B、C、D",
          "title": "Key",
          "type": "string"
        },
        "text": {
          "description": "选项文本",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text"
      ],
      "title": "QuestionOption",
      "type": "object"
    },
    "QuestionView": {
      "properties": {
        "citation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Citation Refs",
          "type": "array"
        },
        "difficulty": {
          "default": "medium",
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image_status": {
          "default": "not_requested",
          "title": "Image Status",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "knowledge_point": {
          "default": "",
          "title": "Knowledge Point",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "title": "Options",
          "type": "array"
        },
        "stem": {
          "title": "Stem",
          "type": "string"
        },
        "type": {
          "enum": [
            "single",
            "multiple",
            "judge"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "stem",
        "options"
      ],
      "title": "QuestionView",
      "type": "object"
    },
    "StudyConceptSummary": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "title"
      ],
      "title": "StudyConceptSummary",
      "type": "object"
    },
    "StudyReviewView": {
