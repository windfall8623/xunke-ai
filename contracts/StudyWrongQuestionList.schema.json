          "maxItems": 3,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
