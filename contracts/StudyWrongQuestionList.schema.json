    "StudyWrongQuestionView": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "association_status": {
          "enum": [
            "linked",
            "unlinked"
          ],
          "title": "Association Status",
          "type": "string"
        },
        "attempt_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "concepts": {
