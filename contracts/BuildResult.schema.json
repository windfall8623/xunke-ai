{
  "$defs": {
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "chunk_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "index_build_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Build Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/DocumentLocator"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "retrieval_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Retrieval Scores",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_type": {
          "const": "document",
          "default": "document",
          "title": "Source Type",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "owner_id",
        "namespace",
        "title",
        "excerpt",
        "text_hash",
        "doc_id",
        "document_version_id",
        "parse_artifact_id",
        "index_build_id",
        "attempt_id",
        "chunk_id",
        "locator"
      ],
      "title": "DocumentEvidence",
      "type": "object"
    },
    "DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "canonical_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Text Hash",
          "type": "string"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "normalizer_version": {
          "title": "Normalizer Version",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "table_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        }
      },
      "required": [
        "source_sha256",
        "parse_artifact_id",
        "canonical_text_hash",
        "parser_version",
        "normalizer_version",
        "block_id",
        "start_char",
        "end_char",
        "quote_hash"
      ],
      "title": "DocumentLocator",
      "type": "object"
    },
    "IndexProfile": {
      "additionalProperties": false,
      "properties": {
        "budget_tokenizer": {
          "default": "utf8-upper-bound-v1",
          "title": "Budget Tokenizer",
          "type": "string"
        },
        "child_overlap_tokens": {
          "default": 64,
          "minimum": 0,
          "title": "Child Overlap Tokens",
          "type": "integer"
        },
        "child_tokens": {
          "default": 384,
          "exclusiveMinimum": 0,
          "title": "Child Tokens",
          "type": "integer"
        },
        "chunk_overlap": {
          "default": 150,
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "chunk_size": {
          "default": 1000,
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunker": {
          "default": "recursive_character",
          "enum": [
            "recursive_character",
            "structure_token"
          ],
          "title": "Chunker",
          "type": "string"
        },
        "embedding_dimensions": {
          "default": 1024,
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_input_version": {
          "default": "plain-canonical-v1",
          "title": "Embedding Input Version",
          "type": "string"
        },
        "embedding_model": {
          "default": "text-embedding-v4",
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_space": {
          "default": "dashscope-compatible-v1",
          "title": "Embedding Space",
          "type": "string"
        },
        "parent_tokens": {
          "default": 1200,
          "exclusiveMinimum": 0,
          "title": "Parent Tokens",
          "type": "integer"
        },
        "profile_id": {
          "default": "legacy-char-v1",
          "title": "Profile Id",
          "type": "string"
        },
        "tokenizer_version": {
          "default": "zh-ascii-v1",
          "title": "Tokenizer Version",
          "type": "string"
        }
      },
      "title": "IndexProfile",
      "type": "object"
    },
    "IndexedNode": {
      "additionalProperties": false,
      "properties": {
        "embedding_text": {
          "title": "Embedding Text",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/DocumentEvidence"
        },
        "is_parent": {
          "default": false,
          "title": "Is Parent",
          "type": "boolean"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "evidence",
        "embedding_text"
      ],
      "title": "IndexedNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "canonical_artifact_key": {
      "title": "Canonical Artifact Key",
      "type": "string"
    },
    "canonical_text_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Text Hash",
      "type": "string"
    },
    "checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "doc_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "document_version_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Document Version Id",
      "type": "string"
    },
    "embedding_dimensions": {
      "exclusiveMinimum": 0,
      "title": "Embedding Dimensions",
      "type": "integer"
    },
    "expected_document_revision": {
      "minimum": 1,
      "title": "Expected Document Revision",
      "type": "integer"
    },
    "index_build_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Index Build Id",
      "type": "string"
    },
    "index_profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Profile Hash",
      "type": "string"
    },
    "namespace": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "node_count": {
      "minimum": 1,
      "title": "Node Count",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IndexedNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "owner_id": {
      "title": "Owner Id",
      "type": "integer"
    },
    "parse_artifact_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Parse Artifact Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/IndexProfile"
    },
    "projection_key": {
      "title": "Projection Key",
      "type": "string"
    },
    "schema_version": {
      "const": "index-build.v1",
      "default": "index-build.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "state": {
      "const": "validated_candidate",
      "default": "validated_candidate",
      "title": "State",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "namespace",
    "doc_id",
    "document_version_id",
    "source_sha256",
    "parse_artifact_id",
    "canonical_text_hash",
    "index_build_id",
    "attempt_id",
    "profile",
    "index_profile_hash",
    "node_count",
    "embedding_dimensions",
    "projection_key",
    "canonical_artifact_key",
    "nodes",
    "checksum",
    "expected_document_revision"
  ],
  "title": "BuildResult",
  "type": "object"
}
