    "NumericRubric": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Absolute Tolerance"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "relative_tolerance": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Relative Tolerance"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Target"
        },
        "unit": {
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "unit_aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Unit Aliases",
          "type": "array"
        },
        "version": {
          "const": "numeric-rules-v1",
          "default": "numeric-rules-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "target",
        "absolute_tolerance",
        "relative_tolerance",
        "unit",
        "unit_aliases",
        "explanation"
      ],
      "title": "NumericRubric",
      "type": "object"
    },
    "PracticeArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "case_type": {
          "const": "practice_generation",
          "default": "practice_generation",
          "title": "Case Type",
          "type": "string"
        },
        "evidence_pack": {
          "$ref": "#/$defs/EvidencePack"
        },
        "mode": {
          "enum": [
            "production",
            "evaluation"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model_fingerprint": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Fingerprint",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "pipeline_config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pipeline Config Hash",
          "type": "string"
        },
        "prompt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
