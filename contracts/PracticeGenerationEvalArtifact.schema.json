            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rubric": {
          "$ref": "#/$defs/NumericRubric"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "support_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Support Quotes",
