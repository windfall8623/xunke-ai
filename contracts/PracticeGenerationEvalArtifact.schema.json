{
  "$defs": {
    "ClozeQuestion": {
      "additionalProperties": false,
      "properties": {
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Citation Refs",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rubric": {
          "$ref": "#/$defs/ClozeRubric"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "support_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Support Quotes",
          "type": "array"
        },
        "type": {
          "const": "cloze",
          "default": "cloze",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stem",
        "difficulty",
        "concept_ids",
        "citation_refs",
        "support_quotes",
        "rubric"
      ],
      "title": "ClozeQuestion",
      "type": "object"
    },
    "ClozeRubric": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "normalization": {
          "default": "nfkc-space-v1",
          "enum": [
            "nfkc-space-v1",
            "nfkc-space-casefold-v1"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ClozeSlot"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Slots",
          "type": "array"
        },
        "version": {
          "const": "cloze-rules-v1",
          "default": "cloze-rules-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "slots",
        "explanation"
      ],
      "title": "ClozeRubric",
      "type": "object"
    },
    "ClozeSlot": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Accepted",
          "type": "array"
        },
        "blank_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Blank Id",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "blank_id",
        "accepted",
        "weight"
      ],
      "title": "ClozeSlot",
      "type": "object"
    },
    "CoveragePlan": {
      "additionalProperties": false,
      "properties": {
        "planner_version": {
          "default": "deterministic-catalog-v1",
          "title": "Planner Version",
          "type": "string"
        },
        "subqueries": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Subqueries",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/CoverageTarget"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "targets",
        "subqueries"
      ],
      "title": "CoveragePlan",
      "type": "object"
    },
    "CoverageTarget": {
      "additionalProperties": false,
      "properties": {
        "doc_ids": {
          "items": {
            "type": "string"
          },
          "title": "Doc Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "question_quota": {
          "maximum": 10,
          "minimum": 1,
          "title": "Question Quota",
          "type": "integer"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "title",
        "question_quota"
      ],
      "title": "CoverageTarget",
      "type": "object"
    },
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "chunk_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "index_build_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Build Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/DocumentLocator"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "retrieval_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Retrieval Scores",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_type": {
          "const": "document",
          "default": "document",
          "title": "Source Type",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "owner_id",
        "namespace",
        "title",
        "excerpt",
        "text_hash",
        "doc_id",
        "document_version_id",
        "parse_artifact_id",
        "index_build_id",
        "attempt_id",
        "chunk_id",
        "locator"
      ],
      "title": "DocumentEvidence",
      "type": "object"
    },
    "DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "canonical_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Text Hash",
          "type": "string"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "normalizer_version": {
          "title": "Normalizer Version",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "table_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        }
      },
      "required": [
        "source_sha256",
        "parse_artifact_id",
        "canonical_text_hash",
        "parser_version",
        "normalizer_version",
        "block_id",
        "start_char",
        "end_char",
        "quote_hash"
      ],
      "title": "DocumentLocator",
      "type": "object"
    },
    "EvidencePack": {
      "additionalProperties": false,
      "properties": {
        "context_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoveragePlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "document": "#/$defs/DocumentEvidence",
                "web": "#/$defs/WebEvidence"
              },
              "propertyName": "source_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DocumentEvidence"
              },
              {
                "$ref": "#/$defs/WebEvidence"
              }
            ]
          },
          "title": "Evidence",
          "type": "array"
        },
        "policy": {
          "enum": [
            "topic",
            "strict_docs",
            "doc_plus_web"
          ],
          "title": "Policy",
          "type": "string"
        },
        "provided_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Provided Evidence Ids",
          "type": "array"
        },
        "resolved_scope": {
          "$ref": "#/$defs/ResolvedScope"
        },
        "status": {
          "enum": [
            "ready",
            "model_only",
            "insufficient"
          ],
          "title": "Status",
          "type": "string"
        },
        "token_count_method": {
          "default": "utf8-upper-bound-v1",
          "title": "Token Count Method",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "trace_id",
        "policy",
        "resolved_scope",
        "status"
      ],
      "title": "EvidencePack",
      "type": "object"
    },
    "LearningEvaluationUsage": {
      "additionalProperties": false,
      "description": "One outer provider ledger; private artifact usage is trace-only.",
      "properties": {
        "calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Calls",
          "type": "array"
        },
        "cost_cny": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Cny"
        },
        "cost_status": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "reported"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "cost_status_cny": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "unknown",
            "not_applicable"
          ],
          "title": "Cost Status Cny",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "embedding_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Calls",
          "type": "integer"
        },
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "fetch_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Fetch Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "known_cost_cny": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Known Cost Cny"
        },
        "ledger_complete": {
          "default": false,
          "title": "Ledger Complete",
          "type": "boolean"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reranker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Reranker Calls",
          "type": "integer"
        },
        "reserved_cost_cny": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserved Cost Cny"
        },
        "search_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "stage_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Ms",
          "type": "object"
        },
        "token_count_method": {
          "default": "provider-reported-or-utf8-upper-bound-v1",
          "title": "Token Count Method",
          "type": "string"
        },
        "unknown_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unknown Call Count",
          "type": "integer"
        },
        "unknown_reserved_cost_cny": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reserved Cost Cny"
        }
      },
      "title": "LearningEvaluationUsage",
      "type": "object"
    },
    "NumericQuestion": {
      "additionalProperties": false,
