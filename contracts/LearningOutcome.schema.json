      ],
      "title": "Confirmation",
      "type": "string"
    },
    "help_usage": {
      "enum": [
        "none",
        "hints",
        "unknown"
      ],
      "title": "Help Usage",
      "type": "string"
    },
    "independent_eligible": {
      "default": false,
      "title": "Independent Eligible",
      "type": "boolean"
    },
    "question_versions": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
