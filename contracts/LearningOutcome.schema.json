      "type": "array"
    },
    "score": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Score"
    },
    "status": {
      "enum": [
        "graded",
        "needs_review",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
