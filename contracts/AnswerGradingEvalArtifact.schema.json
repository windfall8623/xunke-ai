          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Cny"
        },
        "cost_status": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "reported"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "cost_status_cny": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "unknown"
          ],
          "title": "Cost Status Cny",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "embedding_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Calls",
          "type": "integer"
        },
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "fetch_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Fetch Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "known_cost_cny": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Known Cost Cny"
        },
        "ledger_complete": {
          "default": false,
          "title": "Ledger Complete",
          "type": "boolean"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reranker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Reranker Calls",
