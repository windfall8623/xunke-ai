  "additionalProperties": false,
  "properties": {
    "case_type": {
      "const": "answer_grading",
      "default": "answer_grading",
      "title": "Case Type",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "grade": {
      "anyOf": [
        {
          "$ref": "#/$defs/GradeArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repeat_index": {
      "default": 0,
      "minimum": 0,
      "title": "Repeat Index",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sample_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/LearningEvaluationUsage"
    }
