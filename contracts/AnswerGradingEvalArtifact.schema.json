            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reserved Cost Cny"
        },
        "search_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "stage_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Ms",
          "type": "object"
        },
        "token_count_method": {
          "default": "provider-reported-or-utf8-upper-bound-v1",
