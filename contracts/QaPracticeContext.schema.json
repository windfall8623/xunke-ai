{
  "$defs": {
    "AnswerBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Citation Refs",
          "type": "array"
        },
        "kind": {
          "default": "fact",
          "enum": [
            "fact",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "text"
      ],
      "title": "AnswerBlock",
      "type": "object"
    },
    "ResolvedScope": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/SourceManifest"
          },
          "maxItems": 5,
          "title": "Documents",
          "type": "array"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        }
      },
      "required": [
        "owner_id",
        "namespace"
      ],
      "title": "ResolvedScope",
      "type": "object"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "authorization_revision": {
          "minimum": 1,
          "title": "Authorization Revision",
          "type": "integer"
        },
        "canonical_artifact_key": {
          "default": "",
          "title": "Canonical Artifact Key",
          "type": "string"
        },
        "canonical_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Text Hash",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "index_build_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Build Id",
          "type": "string"
        },
        "index_profile_hash": {
          "default": "",
          "title": "Index Profile Hash",
          "type": "string"
        },
        "index_profile_id": {
          "default": "legacy-char-v1",
          "title": "Index Profile Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "projection_key": {
          "default": "",
          "title": "Projection Key",
          "type": "string"
        },
        "section_catalog_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Catalog Revision"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "namespace",
        "doc_id",
        "document_version_id",
        "source_sha256",
        "parse_artifact_id",
        "canonical_text_hash",
        "index_build_id",
        "attempt_id",
        "authorization_revision"
      ],
      "title": "SourceManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Answer Id",
      "type": "string"
    },
    "artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Hash",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "owner_id": {
      "exclusiveMinimum": 0,
      "title": "Owner Id",
      "type": "integer"
    },
    "retrieval_query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Retrieval Query",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ResolvedScope"
    },
    "scope_revision": {
      "minimum": 1,
      "title": "Scope Revision",
      "type": "integer"
    },
    "selected_fact_blocks": {
      "items": {
        "$ref": "#/$defs/AnswerBlock"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Selected Fact Blocks",
      "type": "array"
    },
    "session_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "answer_id",
    "session_id",
    "scope_revision",
    "artifact_hash",
    "scope",
    "retrieval_query",
    "selected_fact_blocks",
    "evidence_ids"
  ],
  "title": "QaPracticeContext",
  "type": "object"
}
