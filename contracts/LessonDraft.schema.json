{
  "$defs": {
    "LessonBlock": {
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "explanation",
            "example",
            "reference",
            "recap"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "LessonBlock",
      "type": "object"
    },
    "LessonCheck": {
      "additionalProperties": false,
      "properties": {
        "check_ref": {
          "title": "Check Ref",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LessonCheckOption"
          },
          "maxItems": 10,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "question_type": {
          "default": "reflection",
          "enum": [
            "single",
            "multiple",
            "judge",
            "short_answer",
            "reflection"
          ],
          "title": "Question Type",
          "type": "string"
        }
      },
      "required": [
        "check_ref",
        "prompt"
      ],
      "title": "LessonCheck",
      "type": "object"
    },
    "LessonCheckOption": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text"
      ],
      "title": "LessonCheckOption",
      "type": "object"
    },
    "LessonPayload": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/LessonBlock"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/LessonCheck"
          },
          "maxItems": 5,
          "title": "Checks",
          "type": "array"
        },
        "estimated_minutes": {
          "maximum": 120,
          "minimum": 1,
          "title": "Estimated Minutes",
          "type": "integer"
        },
        "next_step": {
          "title": "Next Step",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit_ref": {
          "title": "Unit Ref",
          "type": "string"
        }
      },
      "required": [
        "unit_ref",
        "title",
        "objective",
        "estimated_minutes",
        "blocks",
        "next_step"
      ],
      "title": "LessonPayload",
      "type": "object"
    },
    "TeachContext": {
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Id"
        },
        "scope_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Revision"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space Id"
        }
      },
      "title": "TeachContext",
      "type": "object"
    },
    "TeachSource": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "kind": {
          "default": "rag_evidence",
          "enum": [
            "provided_material",
            "rag_evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "title"
      ],
      "title": "TeachSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/TeachContext"
    },
    "kind": {
      "const": "lesson_draft",
      "default": "lesson_draft",
      "title": "Kind",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/LessonPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "schema_version": {
      "const": "zhixue-teach.v1",
      "default": "zhixue-teach.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_policy": {
      "enum": [
        "topic",
        "strict_docs"
      ],
      "title": "Source Policy",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/TeachSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "needs_input",
        "needs_sources",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source_policy"
  ],
  "title": "LessonDraft",
  "type": "object"
}
