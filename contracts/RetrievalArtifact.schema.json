{
  "$defs": {
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "chunk_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "document_version_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "index_build_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Build Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/DocumentLocator"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "retrieval_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Retrieval Scores",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_type": {
          "const": "document",
          "default": "document",
          "title": "Source Type",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "owner_id",
        "namespace",
        "title",
        "excerpt",
        "text_hash",
        "doc_id",
        "document_version_id",
        "parse_artifact_id",
        "index_build_id",
        "attempt_id",
        "chunk_id",
        "locator"
      ],
      "title": "DocumentEvidence",
      "type": "object"
    },
    "DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "canonical_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Text Hash",
          "type": "string"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "normalizer_version": {
          "title": "Normalizer Version",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "parse_artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parse Artifact Id",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "table_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        }
      },
      "required": [
        "source_sha256",
        "parse_artifact_id",
        "canonical_text_hash",
        "parser_version",
        "normalizer_version",
        "block_id",
        "start_char",
        "end_char",
        "quote_hash"
      ],
      "title": "DocumentLocator",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_status": {
          "default": "unreported",
          "enum": [
            "unreported",
            "estimated",
            "reported"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "embedding_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Calls",
          "type": "integer"
        },
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "fetch_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Fetch Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reranker_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Reranker Calls",
          "type": "integer"
        },
        "search_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "stage_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Ms",
          "type": "object"
        },
        "token_count_method": {
          "default": "provider-reported-or-utf8-upper-bound-v1",
          "title": "Token Count Method",
          "type": "string"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "WebEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/WebLocator"
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "exclusiveMinimum": 0,
          "title": "Owner Id",
          "type": "integer"
        },
        "retrieval_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Retrieval Scores",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "snapshot_artifact_key": {
          "default": "",
          "title": "Snapshot Artifact Key",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_type": {
          "const": "web",
          "default": "web",
          "title": "Source Type",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "owner_id",
        "namespace",
        "title",
        "excerpt",
        "text_hash",
        "url",
        "fetched_at",
        "snapshot_id",
        "snapshot_hash",
        "locator"
      ],
      "title": "WebEvidence",
      "type": "object"
    },
    "WebLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start_char",
        "end_char",
        "quote_hash"
      ],
      "title": "WebLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_type": {
      "const": "retrieval",
      "default": "retrieval",
      "title": "Case Type",
      "type": "string"
    },
    "evidence": {
      "items": {
        "discriminator": {
          "mapping": {
            "document": "#/$defs/DocumentEvidence",
            "web": "#/$defs/WebEvidence"
          },
          "propertyName": "source_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DocumentEvidence"
          },
          {
            "$ref": "#/$defs/WebEvidence"
          }
        ]
      },
      "title": "Evidence",
      "type": "array"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "retrieval-artifact.v1",
      "default": "retrieval-artifact.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trace": {
      "additionalProperties": true,
      "title": "Trace",
      "type": "object"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "run_id",
    "evidence"
  ],
  "title": "RetrievalArtifact",
  "type": "object"
}
