{
  "$defs": {
    "AnswerGradingSample": {
      "additionalProperties": true,
      "properties": {
        "annotation": {
          "additionalProperties": true,
          "title": "Annotation",
          "type": "object"
        },
        "answer": {
          "discriminator": {
            "mapping": {
              "cloze": "#/$defs/ClozeAnswer",
              "numeric": "#/$defs/NumericAnswer",
              "short_answer": "#/$defs/ShortAnswer"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ClozeAnswer"
            },
            {
              "$ref": "#/$defs/NumericAnswer"
            },
            {
              "$ref": "#/$defs/ShortAnswer"
            }
          ],
          "title": "Answer"
        },
        "case_type": {
          "const": "answer_grading",
          "default": "answer_grading",
          "title": "Case Type",
          "type": "string"
        },
        "expected_error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Error Code"
        },
        "expected_grade_status": {
          "enum": [
            "graded",
            "needs_review",
            "failed",
            "cancelled"
          ],
          "title": "Expected Grade Status",
          "type": "string"
        },
        "family_ids": {
          "items": {
            "type": "string"
          },
          "title": "Family Ids",
          "type": "array"
        },
        "gold_evidence_groups": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Gold Evidence Groups",
          "type": "array"
        },
        "question": {
          "discriminator": {
            "mapping": {
              "cloze": "#/$defs/ClozeQuestion",
              "numeric": "#/$defs/NumericQuestion",
              "short_answer": "#/$defs/ShortAnswerQuestion"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ClozeQuestion"
            },
            {
              "$ref": "#/$defs/NumericQuestion"
            },
            {
              "$ref": "#/$defs/ShortAnswerQuestion"
            }
          ],
          "title": "Question"
        },
        "question_type": {
          "enum": [
            "cloze",
            "numeric",
            "short_answer"
          ],
          "title": "Question Type",
          "type": "string"
        },
        "question_version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Version",
          "type": "string"
        },
        "reference_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceGrade"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Hash",
          "type": "string"
        },
        "rubric_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rubric Hash",
          "type": "string"
        },
        "sample_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "split": {
          "enum": [
            "dev",
            "judge_calibration",
            "locked_test"
          ],
          "title": "Split",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "split",
        "source_refs",
        "question",
        "question_type",
        "question_version",
        "rubric_hash",
        "answer",
        "response_hash",
        "expected_grade_status"
      ],
      "title": "AnswerGradingSample",
      "type": "object"
    },
    "BlankResponse": {
      "additionalProperties": false,
      "properties": {
        "blank_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Blank Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "blank_id",
        "text"
      ],
      "title": "BlankResponse",
      "type": "object"
    },
    "ClozeAnswer": {
      "additionalProperties": false,
      "properties": {
        "blanks": {
          "items": {
            "$ref": "#/$defs/BlankResponse"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Blanks",
          "type": "array"
        },
        "type": {
          "const": "cloze",
          "default": "cloze",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "blanks"
      ],
      "title": "ClozeAnswer",
      "type": "object"
    },
    "ClozeQuestion": {
      "additionalProperties": false,
      "properties": {
        "citation_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Citation Refs",
          "type": "array"
        },
        "concept_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Concept Ids",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rubric": {
          "$ref": "#/$defs/ClozeRubric"
        },
        "stem": {
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "support_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Support Quotes",
          "type": "array"
        },
        "type": {
          "const": "cloze",
          "default": "cloze",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stem",
        "difficulty",
        "concept_ids",
        "citation_refs",
        "support_quotes",
        "rubric"
      ],
      "title": "ClozeQuestion",
      "type": "object"
    },
    "ClozeRubric": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "normalization": {
          "default": "nfkc-space-v1",
          "enum": [
            "nfkc-space-v1",
            "nfkc-space-casefold-v1"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ClozeSlot"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Slots",
          "type": "array"
        },
        "version": {
          "const": "cloze-rules-v1",
          "default": "cloze-rules-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "slots",
        "explanation"
      ],
      "title": "ClozeRubric",
      "type": "object"
    },
    "ClozeSlot": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Accepted",
          "type": "array"
        },
        "blank_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Blank Id",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "blank_id",
        "accepted",
        "weight"
      ],
      "title": "ClozeSlot",
      "type": "object"
    },
    "NumericAnswer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "numeric",
          "default": "numeric",
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "value": {
