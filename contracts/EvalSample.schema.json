        "citation_refs",
        "support_quotes",
        "rubric"
      ],
      "title": "NumericQuestion",
      "type": "object"
    },
    "NumericRubric": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Absolute Tolerance"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "relative_tolerance": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Relative Tolerance"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Target"
        },
        "unit": {
          "maxLength": 32,
          "title": "Unit",
          "type": "string"
        },
        "unit_aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Unit Aliases",
          "type": "array"
        },
        "version": {
          "const": "numeric-rules-v1",
          "default": "numeric-rules-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "target",
        "absolute_tolerance",
        "relative_tolerance",
        "unit",
        "unit_aliases",
        "explanation"
      ],
      "title": "NumericRubric",
      "type": "object"
    },
